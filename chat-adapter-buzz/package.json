    "test": "node --test \"test/*.test.ts\""
  },
  "peerDependencies": {
    "chat": "^4.45.0"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "nostr-tools": "^2.25.2"
  },
  "devDependencies": {
    "@chat-adapter/state-memory": "4.45.0",
    "@json-render/chat": "0.23.2",
    "@json-render/core": "0.23.2",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "chat": "^4.45.0",
    "typescript": "7.0.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
