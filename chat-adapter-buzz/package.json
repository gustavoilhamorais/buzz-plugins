{
  "name": "chat-adapter-buzz",
  "version": "0.1.0",
  "description": "Buzz adapter for Chat SDK: bots in Buzz channels, with cards rendered by the Chat Cards plugin",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavoilhamorais/buzz-plugins.git",
    "directory": "chat-adapter-buzz"
  },
  "keywords": [
    "chat-sdk",
    "chat-adapter",
    "buzz",
    "nostr",
    "bot"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
